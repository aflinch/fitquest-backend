type Query {
  exercises(id: ID): [Exercise!]

  filteredExercises(where: ExerciseFilter!): [Exercise!]!
}

input ExerciseFilter {
  ids: [ID]
  muscle: String
}

type Exercise {
  id: ID!
  name: String!
  category: String
  mechanic: String
  primaryMuscles: [String]
  secondaryMuscles: [String]
}